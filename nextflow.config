// Configuration for main.nf. The pipeline code does not change between machines;
// only this file does.

params.outdir = "results_nf"      // defined here too, so the reports below follow --outdir

process {
    cpus = 2                       // threads per task (task.cpus in main.nf)
}

executor {
    cpus = 8                       // local runs: never use more than 8 CPUs in total
}

profiles {
    // default: run on this computer
    standard {
        process.executor = 'local'
    }

    // HPC cluster with the SLURM scheduler: each task becomes a cluster job.
    // Not tested on a real cluster: queue name, time and memory must match the cluster.
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        process.time     = '1h'
        process.memory   = '4 GB'
    }
}

// Run reports: what ran, how long, how much CPU and memory
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
